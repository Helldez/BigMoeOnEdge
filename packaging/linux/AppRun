#!/bin/sh
# The AppImage's entry point: bmoe-desktop, the app's window, which starts bmoe-server beside it
# (docs/desktop-app.md). Two other ways in:
#   - `--server [options]` runs bmoe-server alone, with no window: a script, a service. Everything
#     after --server goes to it. With no display at all, that is what runs.
#   - A desktop without WebKitGTK 4.1 cannot start the window (the system's loader reports a
#     missing library): the server then runs as before the app had a window, opening the UI in the
#     browser, inside a terminal window so it can be seen and stopped.
HERE="$(dirname "$(readlink -f "$0")")"
SELF="${APPIMAGE:-$0}"

if [ "${1:-}" = "--server" ]; then
    shift
    exec "$HERE/usr/bin/bmoe-server" "$@"
fi

# No display, no window: the server alone, as with --server.
[ -n "$DISPLAY$WAYLAND_DISPLAY" ] || exec "$HERE/usr/bin/bmoe-server" "$@"

if [ -z "$BMOE_APPIMAGE_TERMINAL" ]; then
    "$HERE/usr/bin/bmoe-desktop" "$@"
    rc=$?
    # 127: the loader could not find a library the window needs. Anything else is the app's own
    # answer, passed on.
    [ $rc -eq 127 ] || exit $rc
    echo "bmoe-desktop could not start (is WebKitGTK 4.1 installed?); opening the UI in the browser instead." >&2
fi

if [ ! -t 1 ] && [ -z "$BMOE_APPIMAGE_TERMINAL" ] && [ -n "$DISPLAY$WAYLAND_DISPLAY" ]; then
    export BMOE_APPIMAGE_TERMINAL=1
    for t in x-terminal-emulator gnome-terminal konsole xfce4-terminal kgx mate-terminal lxterminal xterm; do
        command -v "$t" > /dev/null 2>&1 || continue
        case "$t" in
            gnome-terminal | kgx) exec "$t" -- "$SELF" ;;
            xfce4-terminal) exec "$t" -x "$SELF" ;;
            *) exec "$t" -e "$SELF" ;;
        esac
    done
    # No terminal found: run without one. The server still opens the browser; it stops with the
    # session or with `pkill bmoe-server`.
fi

if [ -n "$BMOE_APPIMAGE_TERMINAL" ] && [ -t 1 ]; then
    echo "BigMoeOnEdge is running. Close this window or press Ctrl+C to stop it."
    echo
fi
"$HERE/usr/bin/bmoe-server" --open
rc=$?
# In a window of its own a failure would vanish with the window: keep it up to be read.
if [ $rc -ne 0 ] && [ -n "$BMOE_APPIMAGE_TERMINAL" ] && [ -t 0 ]; then
    echo
    echo "bmoe-server stopped (exit status $rc). Press Enter to close this window."
    read -r _
fi
exit $rc

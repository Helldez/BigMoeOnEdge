<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks to its own engine over plain HTTP on loopback, which Android forbids by default
     for an app targeting API 28 or later. Permitted for 127.0.0.1 and nothing else: a model
     download goes over HTTPS, and no other host is ever spoken to in clear. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>

<?xml version="1.0" encoding="utf-8"?>
<!-- What the FileProvider may hand out: the metrics CSVs, under the app's own external files dir,
     and the agent's workspace folders, under its files dir. Deliberately not the parents (which also
     hold downloaded multi-GB models and the server's own data): a share sheet has no business being
     able to reach those. -->
<paths>
    <external-files-path
        name="metrics"
        path="metrics/" />
    <files-path
        name="workspaces"
        path="workspaces/" />
</paths>
